# Copy to .env.local and fill in. `npx supabase start` prints the local values.

# Supabase project URL and publishable key (safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase secret key: server only, bypasses RLS. Used by background jobs.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app, used for links in Discord messages
APP_URL=http://localhost:3000

# Local development only: send Inngest events to `npm run inngest:dev`.
# In production, remove this and set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY instead.
INNGEST_DEV=1

# Discord channel webhook for alerts and the daily digest.
# Leave empty to only log the messages.
DISCORD_WEBHOOK_URL=
